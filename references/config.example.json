{
  "_comment": "Copy through bin/configure.sh; runtime belongs under ${CODEX_HOME:-$HOME/.codex}/pitcrew/<project>/config.json.",
  "schema_version": 1,
  "project_name": "example",
  "providers": {
    "forge": "github",
    "tracker": "linear"
  },
  "repos": [
    {
      "name": "example-app",
      "path": "/absolute/path/to/example-app"
    }
  ],
  "release": {
    "autonomy": "off"
  },
  "safety": {
    "confirm_each_remote_action": [],
    "allow_database_writes": false,
    "allow_destructive_git": false,
    "allow_secret_reads": false
  }
}
